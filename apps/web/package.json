{
  "name": "@tutor/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tutor Booking web app (React + Vite)",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../../docs/openapi.yaml -o src/api/schema.d.ts",
    "dev:mock": "VITE_USE_MSW=true vite --host 0.0.0.0 --port 5173"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@hookform/resolvers": "5.9.2",
    "@tanstack/react-query": "5.106.0",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "i18next": "23.16.8",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.91.0",
    "react-i18next": "15.1.3",
    "react-router-dom": "6.30.6",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "25.0.1",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.7.2",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
