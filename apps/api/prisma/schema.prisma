// Schema theo docs/architecture.md §3. Exclusion constraint và partial unique index
// (§3.3) không biểu diễn được trong Prisma: nằm trong migration SQL viết tay
// `prisma/migrations/*_constraints`.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, btree_gist]
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  LOCKED

  @@map("user_status")
}

enum TutorApprovalStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  SUSPENDED

  @@map("tutor_approval_status")
}

enum SlotStatus {
  AVAILABLE
  HELD
  BOOKED
  CLOSED

  @@map("slot_status")
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  EXPIRED
  CANCELLED_BY_STUDENT
  CANCELLED_BY_TUTOR
  CANCELLED_BY_ADMIN

  @@map("booking_status")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum EmailStatus {
  PENDING
  SENT
  FAILED

  @@map("email_status")
}

enum ActorType {
  USER
  SYSTEM
  PROVIDER

  @@map("actor_type")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  email              String     @unique @db.Citext
  passwordHash       String     @map("password_hash")
  fullName           String     @map("full_name") @db.VarChar(100)
  role               UserRole
  status             UserStatus @default(ACTIVE)
  tokenVersion       Int        @default(0) @map("token_version")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutorProfile    TutorProfile?
  studentBookings Booking[]      @relation("BookingStudent")
  tutorBookings   Booking[]      @relation("BookingTutor")
  reviewedTutors  TutorProfile[] @relation("TutorReviewer")
  slots           Slot[]
  reviewsWritten  Review[]       @relation("ReviewStudent")
  reviewsReceived Review[]       @relation("ReviewTutor")
  auditLogs       AuditLog[]

  @@map("users")
}

model TutorProfile {
  userId             String              @id @map("user_id") @db.Uuid
  bio                String              @default("")
  experience         String              @default("")
  pricePerSessionVnd Int?                @map("price_per_session_vnd")
  avatarUrl          String?             @map("avatar_url")
  approvalStatus     TutorApprovalStatus @default(PENDING_APPROVAL) @map("approval_status")
  rejectionReason    String?             @map("rejection_reason")
  reviewedBy         String?             @map("reviewed_by") @db.Uuid
  reviewedAt         DateTime?           @map("reviewed_at") @db.Timestamptz(3)
  ratingAvg          Decimal             @default(0) @map("rating_avg") @db.Decimal(3, 2)
  ratingCount        Int                 @default(0) @map("rating_count")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User           @relation(fields: [userId], references: [id])
  reviewer User?          @relation("TutorReviewer", fields: [reviewedBy], references: [id])
  subjects TutorSubject[]

  @@index([approvalStatus, pricePerSessionVnd])
  @@map("tutor_profiles")
}

model Subject {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(80)
  slug String @unique @db.VarChar(80)

  tutors TutorSubject[]

  @@map("subjects")
}

model TutorSubject {
  tutorId   String @map("tutor_id") @db.Uuid
  subjectId Int    @map("subject_id")

  tutor   TutorProfile @relation(fields: [tutorId], references: [userId], onDelete: Cascade)
  subject Subject      @relation(fields: [subjectId], references: [id])

  @@id([tutorId, subjectId])
  @@map("tutor_subjects")
}

model Slot {
  id        String     @id @default(uuid()) @db.Uuid
  tutorId   String     @map("tutor_id") @db.Uuid
  startAt   DateTime   @map("start_at") @db.Timestamptz(3)
  endAt     DateTime   @map("end_at") @db.Timestamptz(3)
  status    SlotStatus @default(AVAILABLE)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tutor    User      @relation(fields: [tutorId], references: [id])
  bookings Booking[]

  @@index([tutorId, startAt])
  @@index([status, startAt])
  @@map("slots")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  code            BigInt        @unique @default(autoincrement())
  studentId       String        @map("student_id") @db.Uuid
  tutorId         String        @map("tutor_id") @db.Uuid
  slotId          String        @map("slot_id") @db.Uuid
  startAt         DateTime      @map("start_at") @db.Timestamptz(3)
  endAt           DateTime      @map("end_at") @db.Timestamptz(3)
  priceVnd        Int           @map("price_vnd")
  status          BookingStatus
  holdExpiresAt   DateTime?     @map("hold_expires_at") @db.Timestamptz(3)
  rescheduleCount Int           @default(0) @map("reschedule_count") @db.SmallInt
  cancelledAt     DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  cancelledBy     String?       @map("cancelled_by") @db.Uuid
  cancelReason    String?       @map("cancel_reason")
  /// Client-supplied `Idempotency-Key` of POST /bookings; partial unique (student_id, key) lives in SQL.
  idempotencyKey  String?       @map("idempotency_key") @db.VarChar(64)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  student User             @relation("BookingStudent", fields: [studentId], references: [id])
  tutor   User             @relation("BookingTutor", fields: [tutorId], references: [id])
  slot    Slot             @relation(fields: [slotId], references: [id])
  payment Payment?
  review  Review?
  history BookingHistory[]

  @@index([studentId, startAt])
  @@index([tutorId, startAt])
  @@index([status, holdExpiresAt])
  @@map("bookings")
}

model Payment {
  id                 String        @id @default(uuid()) @db.Uuid
  bookingId          String        @unique @map("booking_id") @db.Uuid
  provider           String        @db.VarChar(20)
  providerRef        String        @unique @map("provider_ref") @db.VarChar(64)
  amountVnd          Int           @map("amount_vnd")
  status             PaymentStatus @default(PENDING)
  failureReason      String?       @map("failure_reason") @db.VarChar(30)
  gatewayCompletedAt DateTime?     @map("gateway_completed_at") @db.Timestamptz(3)
  paidAt             DateTime?     @map("paid_at") @db.Timestamptz(3)
  failedAt           DateTime?     @map("failed_at") @db.Timestamptz(3)
  refundRequestedAt  DateTime?     @map("refund_requested_at") @db.Timestamptz(3)
  refundedAt         DateTime?     @map("refunded_at") @db.Timestamptz(3)
  refundRef          String?       @map("refund_ref")
  refundFailed       Boolean       @default(false) @map("refund_failed")
  refundedBy         String?       @map("refunded_by") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking        @relation(fields: [bookingId], references: [id])
  events  PaymentEvent[]

  @@map("payments")
}

model PaymentEvent {
  id             String    @id @default(uuid()) @db.Uuid
  provider       String    @db.VarChar(20)
  eventId        String    @map("event_id") @db.VarChar(64)
  paymentId      String?   @map("payment_id") @db.Uuid
  outcome        String    @db.VarChar(20)
  payload        Json
  rejectedReason String?   @map("rejected_reason")
  receivedAt     DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt    DateTime? @map("processed_at") @db.Timestamptz(3)

  payment Payment? @relation(fields: [paymentId], references: [id])

  @@unique([provider, eventId])
  @@map("payment_events")
}

model Review {
  id        String   @id @default(uuid()) @db.Uuid
  bookingId String   @unique @map("booking_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  tutorId   String   @map("tutor_id") @db.Uuid
  rating    Int      @db.SmallInt
  comment   String?  @db.VarChar(1000)
  isHidden  Boolean  @default(false) @map("is_hidden")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id])
  student User    @relation("ReviewStudent", fields: [studentId], references: [id])
  tutor   User    @relation("ReviewTutor", fields: [tutorId], references: [id])

  @@index([tutorId, createdAt])
  @@map("reviews")
}

model BookingHistory {
  id         BigInt         @id @default(autoincrement())
  bookingId  String         @map("booking_id") @db.Uuid
  fromStatus BookingStatus? @map("from_status")
  toStatus   BookingStatus  @map("to_status")
  fromSlotId String?        @map("from_slot_id") @db.Uuid
  toSlotId   String?        @map("to_slot_id") @db.Uuid
  actorId    String?        @map("actor_id") @db.Uuid
  actorType  ActorType      @map("actor_type")
  note       String?
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  booking Booking @relation(fields: [bookingId], references: [id])

  @@index([bookingId, createdAt])
  @@map("booking_history")
}

model AuditLog {
  id         BigInt   @id @default(autoincrement())
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(50)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id")
  reason     String?
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
}

model EmailOutbox {
  id            String      @id @default(uuid()) @db.Uuid
  toEmail       String      @map("to_email")
  template      String      @db.VarChar(50)
  payload       Json
  status        EmailStatus @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lastError     String?     @map("last_error")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  sentAt        DateTime?   @map("sent_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@map("email_outbox")
}
