{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "node_modules/@nestjs/.+\\.js$": "<rootDir>/test/esm-deps-transform.js",
    "^(?!.*node_modules).+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.json"
      }
    ]
  },
  "setupFiles": [
    "<rootDir>/test/setup-env.ts"
  ],
  "testTimeout": 30000,
  "transformIgnorePatterns": [
    "/node_modules/(?!@nestjs/)"
  ]
}
