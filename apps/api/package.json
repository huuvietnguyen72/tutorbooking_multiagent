{
  "name": "@tutor/api",
  "version": "0.1.0",
  "private": true,
  "description": "Tutor Booking API (NestJS)",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "ts-node src/main.ts",
    "test:unit": "jest --runInBand",
    "test:e2e": "prisma migrate deploy && jest --config test/jest-e2e.json --runInBand",
    "test": "npm run test:unit && npm run test:e2e",
    "prisma:generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "node dist/seed/main.js",
    "seed:dev": "ts-node src/seed/main.ts"
  },
  "dependencies": {
    "@nestjs/common": "10.4.20",
    "@nestjs/core": "10.4.20",
    "@nestjs/platform-express": "10.4.20",
    "@nestjs/throttler": "6.3.0",
    "@prisma/client": "5.22.0",
    "argon2": "0.41.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "nodemailer": "10.3.1",
    "prisma": "5.22.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "10.4.20",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/node": "20.17.10",
    "@types/nodemailer": "6.4.17",
    "@types/supertest": "6.0.2",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  }
}
