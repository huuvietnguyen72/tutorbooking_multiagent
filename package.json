{
  "name": "tutor-booking",
  "version": "0.1.0",
  "private": true,
  "description": "MVP Web Tutor Booking Management",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20 <21"
  },
  "scripts": {
    "lint": "eslint .",
    "build": "npm run build --workspace @tutor/api && npm run build --workspace @tutor/web",
    "test": "npm run test:unit --workspace @tutor/api && npm run test:e2e --workspace @tutor/api && npm run test --workspace @tutor/web",
    "dev:api": "npm run start:dev --workspace @tutor/api",
    "dev:web": "npm run dev --workspace @tutor/web"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1"
  },
  "overrides": {
    "express": "4.22.3",
    "body-parser": "1.20.9",
    "path-to-regexp": "0.1.13",
    "qs": "6.16.2",
    "multer": "2.5.0"
  }
}
