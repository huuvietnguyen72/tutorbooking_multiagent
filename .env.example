# Local/demo environment template.
#
# No passwords or secrets are provided here on purpose. Create the real .env
# with the generator, which writes fresh random secrets:
#
#   ./scripts/init-env.sh
#   ./scripts/init-env.sh --force   # replace an existing .env
#
# Generate individual values with: openssl rand -hex 32
# Never commit .env.

POSTGRES_USER=tutor
POSTGRES_PASSWORD=
POSTGRES_DB=tutor_booking

# >= 32 bytes, must differ from PAYMENT_WEBHOOK_SECRET
JWT_SECRET=
# >= 32 bytes
PAYMENT_WEBHOOK_SECRET=
# >= 12 characters, no default
SEED_ADMIN_PASSWORD=

# Admin login email (default admin@tutor.local). Demo accounts reuse SEED_ADMIN_PASSWORD.
SEED_ADMIN_EMAIL=admin@tutor.local
SEED_DEMO_DATA=true
APP_BASE_URL=http://localhost:8080

# Mock payment gateway (S-08, /mock-gateway/*). Off by default in production; turn on for demos only.
MOCK_GATEWAY_ENABLED=true
